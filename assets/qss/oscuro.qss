* {
    font-family: "Inter", "Segoe UI", "Ubuntu", sans-serif;
    font-size: 14px;
    color: #D7E2F0;
}
QWidget { background-color: transparent; }
QMainWindow { background-color: #0B1220; }

QLabel { background-color: transparent; }
QLabel#titulo {
    font-size: 28px;
    font-weight: 900;
    color: #22D3EE;
    letter-spacing: 3px;
    padding: 4px;
}
QLabel#subtitulo { font-size: 12px; color: #7C8CA3; letter-spacing: 1px; }
QLabel#infoJugador { background: transparent; line-height: 1.4; }
QLabel#confianzaTexto { color: #7C8CA3; font-size: 12px; font-weight: 700; }
QLabel#hud {
    background-color: rgba(15, 24, 42, 240);
    border: 1px solid #1F2E47;
    border-radius: 8px;
    padding: 6px 12px;
    font-weight: 700;
    font-size: 12px;
    color: #D7E2F0;
    letter-spacing: 0.5px;
}
QLabel#tarjeta {
    background-color: rgba(15, 24, 42, 235);
    border: 1px solid #1F2E47;
    border-radius: 14px;
    padding: 12px;
    color: #D7E2F0;
}
QFrame#tarjetaJugador {
    background-color: rgba(15, 24, 42, 240);
    border: 1px solid #22D3EE;
    border-radius: 14px;
}
QLabel#etiquetaBloque {
    color: #22D3EE;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 3px;
    background: transparent;
}
QLabel#pregunta {
    font-size: 19px;
    font-weight: 700;
    color: #F1F5F9;
    background: transparent;
    line-height: 1.45;
}
QLabel#feedback {
    background-color: rgba(10, 18, 32, 245);
    border-left: 4px solid #22D3EE;
    border-radius: 10px;
    padding: 14px;
    font-size: 13px;
    color: #D7E2F0;
}
QLabel#pistaTexto {
    color: #FACC15;
    font-style: italic;
    background-color: rgba(40, 30, 0, 200);
    border-radius: 10px;
    padding: 10px;
    border-left: 4px solid #FACC15;
    font-size: 13px;
}
QFrame#tarjetaPregunta {
    background-color: rgba(8, 14, 26, 245);
    border: 1px solid #1F2E47;
    border-radius: 18px;
}
QPushButton {
    background-color: rgba(20, 30, 50, 235);
    border: 1px solid #1F2E47;
    border-radius: 10px;
    padding: 8px 14px;
    color: #D7E2F0;
    font-weight: 700;
    font-size: 13px;
}
QPushButton:hover {
    background-color: #1E3A5C;
    border: 1px solid #22D3EE;
    color: #FFFFFF;
}
QPushButton#esquina {
    background-color: rgba(15, 24, 42, 235);
    border: 1px solid #22D3EE;
    border-radius: 10px;
    color: #22D3EE;
    font-size: 18px;
    font-weight: 800;
    padding: 0;
}
QPushButton#esquina:hover { background-color: #22D3EE; color: #0B1220; }
QPushButton#botonSecundario {
    background-color: rgba(20, 30, 50, 235);
    border: 1px solid #1F2E47;
    border-radius: 10px;
    padding: 8px 14px;
    font-weight: 700;
    font-size: 12px;
}
QPushButton#botonSecundario:hover {
    background-color: #22D3EE;
    color: #0B1220;
    border: 1px solid #22D3EE;
}
QPushButton#opcion {
    text-align: left;
    padding: 12px 18px;
    font-size: 14px;
    font-weight: 600;
    border-radius: 10px;
    border: 1px solid #1F2E47;
}
QPushButton#opcion:hover {
    background-color: #1E3A5C;
    border: 1px solid #22D3EE;
    padding-left: 24px;
}
QPushButton#opcion[estado="correcto"] {
    background-color: #0F5132;
    color: #D1FAE5;
    border: 2px solid #22C55E;
    font-weight: 800;
}
QPushButton#opcion[estado="incorrecto"] {
    background-color: #7F1D1D;
    color: #FEE2E2;
    border: 2px solid #EF4444;
}
QPushButton#confianza {
    padding: 6px 12px;
    font-size: 11px;
    border-radius: 8px;
    border: 1px solid #1F2E47;
}
QPushButton#confianza:checked {
    background-color: #22D3EE;
    color: #0B1220;
    border: 2px solid #22D3EE;
    font-weight: 800;
}
QPushButton#pista {
    background-color: #FACC15;
    color: #0B1220;
    border: none;
    padding: 8px 16px;
    font-weight: 800;
    border-radius: 10px;
}
QPushButton#pista:hover { background-color: #FDE047; }
QProgressBar#barraXP {
    background-color: rgba(15, 24, 42, 240);
    border: 1px solid #1F2E47;
    border-radius: 10px;
    height: 22px;
    text-align: center;
    color: #0B1220;
    font-weight: 900;
    font-size: 11px;
    letter-spacing: 1px;
}
QProgressBar#barraXP::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #22D3EE, stop:0.5 #A78BFA, stop:1 #F472B6);
    border-radius: 8px;
    margin: 2px;
}
QComboBox, QSpinBox, QLineEdit {
    background-color: rgba(15, 24, 42, 235);
    border: 1px solid #1F2E47;
    border-radius: 8px;
    padding: 6px 10px;
    color: #D7E2F0;
    font-size: 13px;
    min-height: 22px;
}
QComboBox:hover, QSpinBox:hover { border: 1px solid #22D3EE; }
QCheckBox { spacing: 10px; font-size: 13px; }
QCheckBox::indicator {
    width: 18px; height: 18px;
    border-radius: 4px;
    border: 2px solid #1F2E47;
    background-color: #0F182A;
}
QCheckBox::indicator:checked {
    background-color: #22D3EE;
    border-color: #22D3EE;
}
QScrollArea { border: none; background: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; }
QScrollBar::handle:vertical {
    background: #1F2E47; border-radius: 5px; min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: #22D3EE; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }
QMessageBox { background-color: #0F182A; }
QMessageBox QLabel { color: #D7E2F0; background: transparent; }
QMessageBox QPushButton {
    background-color: #22D3EE;
    color: #0B1220;
    border: none;
    border-radius: 8px;
    font-weight: 800;
    padding: 8px 18px;
    min-width: 80px;
}
QMessageBox QPushButton:hover { background-color: #06B6D4; }
QToolTip {
    background-color: #0F182A;
    color: #D7E2F0;
    border: 1px solid #22D3EE;
    border-radius: 6px;
    padding: 6px;
}
/* ---------- LOGIN ---------- */
QDialog { background-color: #0B1220; }
QLabel#etiquetaLogin {
    font-size: 12px;
    color: #7C8CA3;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
}
QLabel#estadoLogin {
    font-size: 13px;
    padding: 8px;
    background: transparent;
}
QLineEdit {
    background-color: rgba(15, 24, 42, 240);
    border: 2px solid #1F2E47;
    border-radius: 10px;
    padding: 10px 14px;
    color: #F1F5F9;
    font-size: 14px;
}
QLineEdit:focus {
    border: 2px solid #22D3EE;
    background-color: rgba(20, 35, 60, 250);
}
QPushButton#tabLogin {
    background-color: rgba(15, 24, 42, 220);
    border: 1px solid #1F2E47;
    border-radius: 10px;
    color: #7C8CA3;
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 1px;
    padding: 8px 16px;
}
QPushButton#tabLogin:checked {
    background-color: #22D3EE;
    color: #0B1220;
    border: 2px solid #22D3EE;
}
QPushButton#tabLogin:hover:!checked {
    border: 1px solid #22D3EE;
    color: #22D3EE;
}
QPushButton#botonPrimario {
    background-color: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 #22D3EE, stop:1 #A78BFA);
    color: #0B1220;
    border: none;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 900;
    letter-spacing: 2px;
}
QPushButton#botonPrimario:hover {
    background-color: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 #06B6D4, stop:1 #8B5CF6);
}

/* ---------- LOGIN (respaldo) ---------- */
QDialog { background-color: #0B1220; }
QDialog QLineEdit {
    background-color: #FFFFFF;
    color: #000000;
    border: 2px solid #334155;
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 15px;
    font-weight: 700;
}
QDialog QLineEdit:focus {
    border: 2px solid #22D3EE;
    background-color: #F0FDFF;
    color: #000000;
}
QDialog QLineEdit::placeholder {
    color: #94A3B8;
}


/* ---------- ETIQUETA XP (FUERA de la barra) ---------- */
QLabel#etiquetaXP {
    color: #67E8F9; font-size: 12px; font-weight: 800; letter-spacing: 2px;
    background: transparent;
    padding: 2px 8px;
}
QProgressBar#barraXP {
    background-color: #0A1628;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    height: 16px;
    text-align: center;
}
QProgressBar#barraXP::chunk {
    background-color: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #22D3EE, stop:0.5 #A78BFA, stop:1 #F472B6);
    border-radius: 7px;
    margin: 1px;
}

QPushButton#botonDestacado {
    background-color: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 rgba(34,211,238,80), stop:1 rgba(167,139,250,80));
    border: 2px solid #22D3EE;
    border-radius: 12px;
    color: #F1F5F9;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 1px;
}
QPushButton#botonDestacado:hover {
    background-color: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 #22D3EE, stop:1 #A78BFA);
    color: #0B1220;
}
QPushButton#tabRanking {
    background-color: rgba(15,24,42,220);
    border: 1px solid #1F2E47;
    border-radius: 10px;
    color: #7C8CA3;
    font-weight: 800;
    padding: 8px 14px;
}
QPushButton#tabRanking:checked {
    background-color: #22D3EE;
    color: #0B1220;
    border: 2px solid #22D3EE;
}
QFrame#filaRanking {
    background-color: rgba(15,24,42,220);
    border: 1px solid #1F2E47;
    border-radius: 12px;
}
QFrame#filaRankingActual {
    background-color: rgba(34,211,238,35);
    border: 2px solid #22D3EE;
    border-radius: 12px;
}
QLabel#labelForm {
    color: #94A3B8; font-size: 12px; font-weight: 800;
    letter-spacing: 1px; background: transparent;
}
