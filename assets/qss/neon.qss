* {
    font-family: "Inter", "Segoe UI", "Ubuntu", sans-serif;
    font-size: 14px;
    color: #FFE5FF;
}
QWidget { background-color: transparent; }
QMainWindow { background-color: #0A0014; }

QLabel { background-color: transparent; }
QLabel#titulo {
    font-size: 28px; font-weight: 900;
    color: #FF00FF;
    letter-spacing: 4px;
}
QLabel#subtitulo { font-size: 12px; color: #B47AFF; letter-spacing: 2px; }
QLabel#infoJugador { background: transparent; line-height: 1.4; }
QLabel#confianzaTexto { color: #B47AFF; font-size: 12px; font-weight: 700; }
QLabel#hud {
    background-color: rgba(26, 0, 51, 240);
    border: 1px solid #FF00FF;
    border-radius: 8px;
    padding: 6px 12px;
    font-weight: 700; font-size: 12px; color: #FFE5FF;
}
QLabel#tarjeta {
    background-color: rgba(26, 0, 51, 235);
    border: 1px solid #FF00FF;
    border-radius: 14px;
    padding: 12px; color: #FFE5FF;
}
QFrame#tarjetaJugador {
    background-color: rgba(26, 0, 51, 240);
    border: 2px solid #00FFFF;
    border-radius: 14px;
}
QLabel#etiquetaBloque {
    color: #00FFFF; font-size: 11px; font-weight: 900;
    letter-spacing: 3px; background: transparent;
}
QLabel#pregunta {
    font-size: 19px; font-weight: 700; color: #FFE5FF;
    background: transparent; line-height: 1.45;
}
QLabel#feedback {
    background-color: rgba(15, 0, 30, 240);
    border-left: 4px solid #FF00FF;
    border-radius: 10px; padding: 14px;
    font-size: 13px; color: #FFE5FF;
}
QLabel#pistaTexto {
    color: #FFEA00; font-style: italic;
    background-color: rgba(40, 30, 0, 220);
    border-radius: 10px; padding: 10px;
    border-left: 4px solid #FFEA00;
}
QFrame#tarjetaPregunta {
    background-color: rgba(13, 0, 26, 245);
    border: 2px solid #FF00FF;
    border-radius: 18px;
}
QPushButton {
    background-color: rgba(26, 0, 51, 235);
    border: 1px solid #FF00FF;
    border-radius: 10px;
    padding: 8px 14px;
    color: #FFE5FF; font-weight: 700;
}
QPushButton:hover {
    background-color: #FF00FF; color: #0A0014;
    border: 2px solid #FF00FF;
}
QPushButton#esquina {
    background-color: rgba(26, 0, 51, 235);
    border: 2px solid #00FFFF;
    border-radius: 10px;
    color: #00FFFF; font-weight: 800;
}
QPushButton#esquina:hover { background-color: #00FFFF; color: #0A0014; }
QPushButton#botonSecundario {
    background-color: rgba(26, 0, 51, 235);
    border: 1px solid #FF00FF;
    border-radius: 10px;
    padding: 8px 14px; font-weight: 700; font-size: 12px;
    color: #FFE5FF;
}
QPushButton#botonSecundario:hover {
    background-color: #FF00FF; color: #0A0014;
}
QPushButton#opcion {
    text-align: left; padding: 12px 18px;
    font-size: 14px; font-weight: 600;
    border-radius: 10px;
    border: 1px solid #FF00FF;
    background-color: rgba(26, 0, 51, 235);
    color: #FFE5FF;
}
QPushButton#opcion:hover {
    background-color: rgba(255, 0, 255, 60);
    border: 2px solid #00FFFF;
}
QPushButton#opcion[estado="correcto"] {
    background-color: #00FF88; color: #0A0014;
    border: 2px solid #00FF88;
    font-weight: 800;
}
QPushButton#opcion[estado="incorrecto"] {
    background-color: #FF0055; color: #FFFFFF;
    border: 2px solid #FF0055;
}
QPushButton#confianza {
    padding: 6px 12px; font-size: 11px; border-radius: 8px;
    border: 1px solid #FF00FF;
    background-color: rgba(26, 0, 51, 235);
    color: #FFE5FF;
}
QPushButton#confianza:checked {
    background-color: #00FFFF; color: #0A0014;
    border: 2px solid #00FFFF;
    font-weight: 800;
}
QPushButton#pista {
    background-color: #FFEA00; color: #0A0014;
    border: none; padding: 8px 16px;
    font-weight: 800; border-radius: 10px;
}
QProgressBar#barraXP {
    background-color: rgba(26, 0, 51, 240);
    border: 1px solid #FF00FF;
    border-radius: 10px;
    height: 22px; text-align: center;
    color: #0A0014; font-weight: 900; font-size: 11px;
}
QProgressBar#barraXP::chunk {
    background-color: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 #FF00FF, stop:0.5 #00FFFF, stop:1 #FF00FF);
    border-radius: 8px; margin: 2px;
}
QComboBox, QSpinBox, QLineEdit {
    background-color: rgba(26, 0, 51, 235);
    border: 1px solid #FF00FF;
    border-radius: 8px;
    padding: 6px 10px;
    color: #FFE5FF;
    min-height: 22px;
}
QCheckBox { spacing: 10px; color: #FFE5FF; }
QCheckBox::indicator {
    width: 18px; height: 18px; border-radius: 4px;
    border: 2px solid #FF00FF; background-color: #1A0033;
}
QCheckBox::indicator:checked { background-color: #00FFFF; border-color: #00FFFF; }
QScrollArea { border: none; background: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; }
QScrollBar::handle:vertical { background: #FF00FF; border-radius: 5px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }
QMessageBox { background-color: #1A0033; }
QMessageBox QLabel { color: #FFE5FF; background: transparent; }
QMessageBox QPushButton {
    background-color: #FF00FF; color: #0A0014;
    border: none; border-radius: 8px; font-weight: 800;
    padding: 8px 18px;
}
QDialog { background-color: #0A0014; }
QDialog QLineEdit {
    background-color: #FFFFFF; color: #000000;
    border: 2px solid #FF00FF; border-radius: 10px;
    padding: 10px 14px; font-size: 15px; font-weight: 700;
}
QDialog QLineEdit:focus { border: 2px solid #00FFFF; }


/* ---------- ETIQUETA XP (FUERA de la barra) ---------- */
QLabel#etiquetaXP {
    color: #00FFFF; font-size: 12px; font-weight: 900; letter-spacing: 3px;
    background: transparent;
    padding: 2px 8px;
}
QProgressBar#barraXP {
    background-color: #1A0033;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    height: 16px;
    text-align: center;
}
QProgressBar#barraXP::chunk {
    background-color: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #FF00FF, stop:0.5 #00FFFF, stop:1 #FF00FF);
    border-radius: 7px;
    margin: 1px;
}

QPushButton#botonDestacado {
    border: 2px solid #FF00FF;
    border-radius: 12px;
    background-color: rgba(0,0,0,0.3);
    color: #FF00FF;
    font-weight: 800;
    padding: 10px 14px;
}
QPushButton#botonDestacado:hover {
    background-color: #FF00FF;
    color: #000000;
}
QPushButton#tabRanking {
    border: 1px solid #FF00FF;
    border-radius: 10px;
    background-color: rgba(0,0,0,0.3);
    color: #FF00FF;
    font-weight: 800;
    padding: 8px 14px;
}
QPushButton#tabRanking:checked {
    background-color: #FF00FF;
    color: #000000;
}
QFrame#filaRanking {
    background-color: rgba(0,0,0,0.4);
    border: 1px solid #FF00FF;
    border-radius: 12px;
}
QFrame#filaRankingActual {
    background-color: rgba(0,0,0,0.6);
    border: 2px solid #FF00FF;
    border-radius: 12px;
}
QLabel#labelForm {
    color: #FF00FF; font-weight: 800; background: transparent;
}
