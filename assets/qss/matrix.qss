* {
    font-family: "Consolas", "JetBrains Mono", "Ubuntu Mono", monospace;
    font-size: 14px;
    color: #00FF41;
}
QWidget { background-color: transparent; }
QMainWindow { background-color: #000000; }

QLabel { background-color: transparent; }
QLabel#titulo {
    font-size: 28px; font-weight: 900;
    color: #00FF41;
    letter-spacing: 4px;
}
QLabel#subtitulo { font-size: 12px; color: #008F11; letter-spacing: 2px; }
QLabel#infoJugador { background: transparent; line-height: 1.4; color: #00FF41; }
QLabel#confianzaTexto { color: #008F11; font-weight: 700; }
QLabel#hud {
    background-color: rgba(0, 20, 0, 240);
    border: 1px solid #00FF41;
    border-radius: 4px;
    padding: 6px 12px;
    font-weight: 700; font-size: 12px; color: #00FF41;
}
QLabel#tarjeta {
    background-color: rgba(0, 15, 0, 235);
    border: 1px solid #00FF41;
    border-radius: 4px;
    padding: 12px; color: #00FF41;
}
QFrame#tarjetaJugador {
    background-color: rgba(0, 20, 0, 240);
    border: 2px solid #00FF41;
    border-radius: 4px;
}
QLabel#etiquetaBloque {
    color: #00FF41; font-size: 11px; font-weight: 900;
    letter-spacing: 3px; background: transparent;
}
QLabel#pregunta {
    font-size: 19px; font-weight: 700; color: #00FF41;
    background: transparent;
}
QLabel#feedback {
    background-color: rgba(0, 15, 0, 240);
    border-left: 4px solid #00FF41;
    border-radius: 4px; padding: 14px; color: #00FF41;
}
QLabel#pistaTexto {
    color: #00FF41; font-style: italic;
    background-color: rgba(0, 30, 0, 220);
    border-radius: 4px; padding: 10px;
    border-left: 4px solid #00FF41;
}
QFrame#tarjetaPregunta {
    background-color: rgba(0, 10, 0, 245);
    border: 2px solid #00FF41;
    border-radius: 6px;
}
QPushButton {
    background-color: rgba(0, 15, 0, 235);
    border: 1px solid #00FF41;
    border-radius: 4px;
    padding: 8px 14px;
    color: #00FF41; font-weight: 700;
}
QPushButton:hover {
    background-color: #00FF41; color: #000000;
}
QPushButton#esquina {
    background-color: rgba(0, 20, 0, 235);
    border: 2px solid #00FF41;
    border-radius: 4px;
    color: #00FF41; font-weight: 800;
}
QPushButton#esquina:hover { background-color: #00FF41; color: #000000; }
QPushButton#botonSecundario {
    background-color: rgba(0, 15, 0, 235);
    border: 1px solid #00FF41;
    border-radius: 4px;
    padding: 8px 14px; font-weight: 700;
    color: #00FF41;
}
QPushButton#botonSecundario:hover { background-color: #00FF41; color: #000000; }
QPushButton#opcion {
    text-align: left; padding: 12px 18px;
    border-radius: 4px;
    border: 1px solid #00FF41;
    background-color: rgba(0, 15, 0, 235);
    color: #00FF41;
}
QPushButton#opcion:hover {
    background-color: rgba(0, 255, 65, 60);
    border: 2px solid #00FF41;
    padding-left: 24px;
}
QPushButton#opcion[estado="correcto"] {
    background-color: #00FF41; color: #000000;
    border: 2px solid #00FF41; font-weight: 800;
}
QPushButton#opcion[estado="incorrecto"] {
    background-color: #FF0000; color: #FFFFFF;
    border: 2px solid #FF0000;
}
QPushButton#confianza {
    padding: 6px 12px; font-size: 11px;
    border: 1px solid #00FF41;
    background-color: rgba(0, 15, 0, 235);
    color: #00FF41;
}
QPushButton#confianza:checked {
    background-color: #00FF41; color: #000000;
    font-weight: 800;
}
QPushButton#pista {
    background-color: #00FF41; color: #000000;
    border: none; font-weight: 800; border-radius: 4px;
}
QProgressBar#barraXP {
    background-color: rgba(0, 20, 0, 240);
    border: 1px solid #00FF41;
    border-radius: 4px;
    height: 22px; text-align: center;
    color: #000000; font-weight: 900;
}
QProgressBar#barraXP::chunk {
    background-color: #00FF41;
    border-radius: 2px; margin: 2px;
}
QComboBox, QSpinBox, QLineEdit {
    background-color: rgba(0, 15, 0, 235);
    border: 1px solid #00FF41;
    border-radius: 4px;
    padding: 6px 10px;
    color: #00FF41; min-height: 22px;
}
QCheckBox { spacing: 10px; color: #00FF41; }
QCheckBox::indicator {
    width: 18px; height: 18px; border-radius: 2px;
    border: 2px solid #00FF41; background-color: #000000;
}
QCheckBox::indicator:checked { background-color: #00FF41; border-color: #00FF41; }
QScrollArea { border: none; background: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; }
QScrollBar::handle:vertical { background: #00FF41; border-radius: 2px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }
QMessageBox { background-color: #001100; }
QMessageBox QLabel { color: #00FF41; background: transparent; }
QMessageBox QPushButton {
    background-color: #00FF41; color: #000000;
    border: none; font-weight: 800;
    padding: 8px 18px;
}
QDialog { background-color: #000000; }
QDialog QLineEdit {
    background-color: #FFFFFF; color: #000000;
    border: 2px solid #00FF41; border-radius: 4px;
    padding: 10px 14px; font-weight: 700;
}
QDialog QLineEdit:focus { border: 2px solid #00FF41; }


/* ---------- ETIQUETA XP (FUERA de la barra) ---------- */
QLabel#etiquetaXP {
    color: #00FF41; font-size: 12px; font-weight: 900; letter-spacing: 3px;
    background: transparent;
    padding: 2px 8px;
}
QProgressBar#barraXP {
    background-color: #001100;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    height: 16px;
    text-align: center;
}
QProgressBar#barraXP::chunk {
    background-color: #00FF41;
    border-radius: 7px;
    margin: 1px;
}

QPushButton#botonDestacado {
    border: 2px solid #00FF41;
    border-radius: 12px;
    background-color: rgba(0,0,0,0.3);
    color: #00FF41;
    font-weight: 800;
    padding: 10px 14px;
}
QPushButton#botonDestacado:hover {
    background-color: #00FF41;
    color: #000000;
}
QPushButton#tabRanking {
    border: 1px solid #00FF41;
    border-radius: 10px;
    background-color: rgba(0,0,0,0.3);
    color: #00FF41;
    font-weight: 800;
    padding: 8px 14px;
}
QPushButton#tabRanking:checked {
    background-color: #00FF41;
    color: #000000;
}
QFrame#filaRanking {
    background-color: rgba(0,0,0,0.4);
    border: 1px solid #00FF41;
    border-radius: 12px;
}
QFrame#filaRankingActual {
    background-color: rgba(0,0,0,0.6);
    border: 2px solid #00FF41;
    border-radius: 12px;
}
QLabel#labelForm {
    color: #00FF41; font-weight: 800; background: transparent;
}
